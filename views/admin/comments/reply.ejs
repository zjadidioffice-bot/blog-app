<div class="reply-page">
<h1 class="page-title">پاسخ به دیدگاه</h1>
</div>
<div class="original-comment">
    <h3>نظر کاربر</h3>
<div class="commnet-user">
    <strong>
        <%= comment.name %>
    </strong>
</div>
<p class="comment-content">
    <%= comment.body %>
</p>
</div>

<div class="reply-box">
<h3>پاسخ مدیر</h3>
<form action="/admin/comments/<%= comment._id %>/reply"
 method="post">

<textarea
name="body"
rows="6"
required
></textarea>


<button type="submit" class="reply-submit-btn">ثبت پاسخ</button>
</form>
</div>
