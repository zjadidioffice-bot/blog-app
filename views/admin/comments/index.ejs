<h1 class="page-title">مدیریت دیدگاه‌ها</h1>

<div class="table-container">

<table class="admin-table" border="1" cellpadding="10">

    <thead>
        <tr>
            <th>نویسنده</th>
            <th>پست</th>
            <th>متن</th>
            <th>وضعیت</th>
            <th>عملیات</th>
        </tr>
    </thead>

    <tbody>

    <% comments.forEach(comment => { %>

        <tr>

            <td>
                <%= comment.name %>
            </td>

            <td>
                <%= comment.post?.title %>
            </td>

            <td class="comment-text">
                <%= comment.body %>
            </td>

            <td>

                <% if(comment.isApproved){ %>

                    <span class="status approved">
                        ✅ تایید شده
                    </span>

                <% }else{ %>

                    <span class="status pending">
                        در انتظار تایید
                    </span>

                <% } %>

            </td>

            <td class="actions">

                <% if (!comment.isApproved){%>
                    <form
                        action="/admin/comments/<%= comment._id %>/approve"
                        method="POST"
                        style="display:inline;"
                    >

                        <button class="btn approved-btn" type="submit">
                            تایید
                        </button>

                    </form
                    <% } %>

                    <a class="btn reply-btn" href="/admin/comments/<%= comment._id %>/reply">
                        پاسخ</a>



                <form
                    action="/admin/comments/<%= comment._id %>/delete"
                    method="POST"
                    style="display:inline;"
                >

                    <button
                    class="btn delete-btn"
                        type="submit"
                        onclick="return confirm('حذف شود؟')"
                    >
                        حذف
                    </button>

                </form>

            </td>

        </tr>

    <% }) %>

    </tbody>

</table>

</div>
