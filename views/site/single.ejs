<section class="single-post">
    <div class="container">
        <div class="single-image">
            <img src="/uploads/<%= post.image %>" alt="<%= post.title %>">
        </div>
        <div class="single-content">
            <h1>
                <%= post.title %>
            </h1>
            <div class="single-meta">
                <span>
                    دسته بندی:
                    <%= post.category?.name %>
                </span>
                <span>
                    <%= post.createdAt.toLocaleDateString("fa-IR") %>
                </span>
                <div class="single-body">
                    <%= post.body %>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="comments-section">
    <div class="container">
        <h2>ثبت دیدگاه</h2>
        <form action="/blog/<%= post._id %>/comments" method="post" class="comment-form">
            <div class="form-group">
                <label>نام</label>
                <input type="text" name="name" required>
            </div>
            <div class="form-group">
                <label>ایمیل</label>
                <input type="email" name="email" required>
            </div>
            <div class="form-group">
                <label>متن دیدگاه</label>
                <textarea name="body" rows="6" required></textarea>
            </div>
            <button type="submit">ثبت دیدگاه</button>
        </form>
    </div>
</section>
<section class="comments-list">
    <div class="container">
        <h2>دیدگاه ها</h2>
        <% if(comments.length===0){ %>
            <p>هنوز دیدگاهی ثبت نشده است</p>
            <% } %>
                <% comments.forEach(comment=>{%>
                    <div class="comment-item">
                        <h4>
                            <%= comment.name %>
                        </h4>
                        <small>
                            <%= comment.createdAt.toLocaleDateString("fa-IR") %>
                        </small>
                        <p>
                            <%= comment.body %>
                        </p>
                    </div>
                
                    <% }) %>
    </div>
</section>